# バックエンド用環境変数（コピーして .env にリネームし、値を入力）

PORT=8080
GEMINI_API_KEY=your_gemini_api_key
TMDB_API_KEY=your_tmdb_api_key
VITE_FIREBASE_PROJECT_ID=typecast-v2
FIRESTORE_DB_NAME=(default)

# 1日あたりのレコメンド上限（未設定なら 3）
DAILY_RECOMMEND_LIMIT=3

# 必須: プロンプトテンプレート（改行は \n、プレースホルダ %s は mbti, Main, Sub, mood, ignoreStr, Main, Sub の順で7つ）
# 例: GEMINI_PROMPT_TEMPLATE="あなたは...\nターゲット: %s型\n..."
GEMINI_PROMPT_TEMPLATE=
